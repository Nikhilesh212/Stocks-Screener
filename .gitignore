.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
data/cache/
data/manual/*
!data/manual/README.md
*.pdf

# recorded test fixtures are real NSE responses and company filings: NSE's terms restrict
# redistributing its data, so each machine records its own (tests/fixtures/record.py --fetch)
tests/fixtures/*
!tests/fixtures/*.py
!tests/fixtures/README*
!tests/fixtures/.gitkeep

# ledger dry runs (Session F uses ledger/test)
ledger/test/

# personal research output stays on this machine: the GitHub repository is public
runs/
ledger/*.jsonl
ledger/postmortems/
ledger/lessons.md
