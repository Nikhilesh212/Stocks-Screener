# All optional. Copy to .env and fill only what you have. Never commit .env.
# Values are read with python-dotenv; tools never print them.

# Override the HTTP User-Agent sent to data sources (default identifies this tool honestly).
# ER_USER_AGENT="equity-research-tool/0.1 (personal research; contact: you@example.com)"

# Read-only broker API credentials (not used unless you add a broker adapter; never use order scopes).
# KITE_API_KEY=
# KITE_ACCESS_TOKEN=

# FRED API key (optional; macro fallback). https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=
